# Telegram Bot credentials
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: path to Gmail OAuth credentials file (default: credentials.json)
GMAIL_CREDENTIALS_FILE=credentials.json

# Optional: path to token cache file (default: token.json)
GMAIL_TOKEN_FILE=token.json

# Optional: path to processed-IDs file to avoid duplicate alerts (default: processed_ids.json)
PROCESSED_IDS_FILE=processed_ids.json

# Optional: how many emails to scan per run (default: 50)
MAX_RESULTS=50
